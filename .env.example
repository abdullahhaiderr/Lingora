# Required: create an Azure AI Translator resource in Azure Portal.
# Use an actual server-side key only in .env locally or in Vercel's Environment Variables.
AZURE_TRANSLATOR_KEY=replace-with-your-azure-translator-secret-key

# Required for regional/multi-service resources; optional for global Translator resources.
AZURE_TRANSLATOR_REGION=your-resource-region

# Optional. Leave blank for Microsoft's default Translator REST endpoint.
# For regional/custom resource endpoints, use the HTTPS base URL from Azure Portal.
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Local Express API port (optional)
PORT=3001
